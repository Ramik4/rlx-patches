    <string name="morphe_custom_branding_name_entry_5" translatable="false">YouTube Music</string>
    <string name="morphe_custom_branding_name_entry_6" translatable="false">YT Music X</string>
    <string name="morphe_custom_branding_name_entry_7" translatable="false">YT Music Morphe</string>
    <string name="morphe_custom_branding_name_entry_8" translatable="false">Music Morphe</string>
